__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

cases/*
!cases/.gitkeep

# GUI의 04단계 파싱 캐시. cases/·evidence/ 와 같은 부류다 — 증거에서
# 나온 산출물이라 커밋하지 않는다.
.cache/

# 08단계 캠페인 산출물. 노드 케이스에서 나온 것이라 같은 부류다.
campaigns/*
!campaigns/.gitkeep

# 증거는 커밋하지 않는다. 실제 사건 데이터가 들어 있고 용량이 크다.
# 이미지뿐 아니라 추출 결과(FTK Imager의 [root]/ 등)도 마찬가지다.
evidence/*
!evidence/.gitkeep

benchmark/datasets/*/evidence/
benchmark/results/*
!benchmark/results/.gitkeep

tests/fixtures/*.bin
*.dd
*.E01
*.raw
*.vmdk

.DS_Store
.idea/
.vscode/

# 에이전트 설정: settings.json 은 팀 공용(커밋), local 은 개인용(제외).
# 개인 승인 항목이 팀 리포에 섞이지 않게 한다.
.claude/settings.local.json

# KAPE 바이너리 및 도구
KAPE_Tools/

